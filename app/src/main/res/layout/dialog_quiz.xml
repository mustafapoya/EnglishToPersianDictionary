<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bottom_sheet_rounded_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/screen_gutter"
        android:paddingTop="12dp"
        android:paddingBottom="20dp">

        <View
            android:layout_width="40dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="16dp"
            android:background="@drawable/drag_handle" />

        <!-- Header: title, streak and question counter -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/quiz_title"
                style="@style/AppScreenTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/quiz_title"
                android:textSize="22sp" />

            <TextView
                android:id="@+id/quiz_streak_text"
                style="@style/AppTallyPill"
                android:backgroundTint="?attr/colorTertiaryContainer"
                android:textColor="?attr/colorOnTertiaryContainer"
                tools:text="🔥 2" />

            <TextView
                android:id="@+id/quiz_progress_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:textColor="?attr/appTextSecondary"
                android:textSize="14sp"
                android:textStyle="bold"
                tools:text="1 / 5" />
        </LinearLayout>

        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/quiz_progress_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:max="5"
            app:indicatorColor="?attr/colorPrimary"
            app:trackColor="?attr/colorPrimaryContainer"
            app:trackCornerRadius="4dp"
            app:trackThickness="6dp" />

        <LinearLayout
            android:id="@+id/quiz_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="vertical">

            <!-- Question: the same blue card as the flashcard front -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@android:color/transparent"
                app:cardCornerRadius="@dimen/card_radius_large"
                app:cardElevation="0dp"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_hero"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="20dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/quiz_question_prompt"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/quiz_question_title"
                            android:textColor="@color/hero_accent"
                            android:textSize="13sp" />

                        <TextView
                            android:id="@+id/quiz_word_text"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:textColor="@color/hero_on"
                            android:textDirection="ltr"
                            android:textSize="30sp"
                            android:textStyle="bold"
                            tools:text="resilience" />
                    </LinearLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/quiz_btn_speak"
                        style="@style/AppIconButtonFilled"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:contentDescription="@string/action_listen"
                        app:backgroundTint="@color/hero_button"
                        app:icon="@drawable/ic_volume_up"
                        app:iconTint="@color/hero_on" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Four answer options -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="vertical">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/quiz_option_0"
                    style="@style/AppQuizOption"
                    tools:text="گزینه اول" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/quiz_option_1"
                    style="@style/AppQuizOption"
                    tools:text="گزینه دوم" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/quiz_option_2"
                    style="@style/AppQuizOption"
                    tools:text="گزینه سوم" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/quiz_option_3"
                    style="@style/AppQuizOption"
                    tools:text="گزینه چهارم" />
            </LinearLayout>

            <!-- Feedback (colours set in code) -->
            <TextView
                android:id="@+id/quiz_feedback_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:background="@drawable/bg_rounded"
                android:gravity="center"
                android:lineSpacingMultiplier="1.2"
                android:paddingHorizontal="16dp"
                android:paddingVertical="12dp"
                android:textDirection="anyRtl"
                android:textSize="14sp"
                android:textStyle="bold"
                android:visibility="gone"
                tools:text="@string/quiz_correct"
                tools:visibility="visible" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/quiz_btn_next"
                style="@style/AppButton"
                android:layout_width="match_parent"
                android:layout_marginTop="12dp"
                android:text="@string/quiz_next_word"
                android:visibility="gone"
                app:icon="@drawable/ic_arrow_forward"
                app:iconGravity="end" />
        </LinearLayout>

        <!-- Result -->
        <LinearLayout
            android:id="@+id/quiz_summary_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingTop="20dp"
            android:visibility="gone">

            <FrameLayout
                android:layout_width="88dp"
                android:layout_height="88dp"
                android:background="@drawable/bg_icon_circle">

                <TextView
                    android:id="@+id/quiz_result_emoji"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:textSize="40sp"
                    tools:text="🏆" />
            </FrameLayout>

            <TextView
                android:id="@+id/quiz_result_title"
                style="@style/AppEmptyTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/quiz_completed_title"
                android:textSize="22sp" />

            <TextView
                android:id="@+id/quiz_result_score"
                style="@style/AppEmptyMessage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="15sp"
                tools:text="You scored 4 out of 5 (80%)" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/quiz_btn_play_again"
                style="@style/AppButton"
                android:layout_width="match_parent"
                android:layout_marginTop="24dp"
                android:text="@string/quiz_play_again"
                app:icon="@drawable/ic_refresh" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/quiz_btn_close"
                style="@style/AppButton.Outlined"
                android:layout_width="match_parent"
                android:layout_marginTop="8dp"
                android:text="@string/quiz_done" />
        </LinearLayout>

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
