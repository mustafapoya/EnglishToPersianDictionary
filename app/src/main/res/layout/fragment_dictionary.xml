<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/appBackgroundColor"
    android:orientation="vertical"
    tools:context=".ui.dictionary.DictionaryFragment">

    <!-- ── Header: title with the direction switch, then the search field ──── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingTop="12dp">

        <TextView
            style="@style/AppScreenTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/title_dictionary" />

        <include
            android:id="@+id/direction_switch"
            layout="@layout/view_direction_switch" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="12dp"
        android:addStatesFromChildren="true"
        android:background="@drawable/bg_field"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="6dp">

        <ImageView
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_search"
            app:tint="?attr/colorPrimary" />

        <EditText
            android:id="@+id/edit_search"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginHorizontal="10dp"
            android:layout_weight="1"
            android:autofillHints=""
            android:background="@null"
            android:hint="@string/search_english_hint"
            android:imeOptions="actionSearch"
            android:inputType="text"
            android:maxLines="1"
            android:textColor="?attr/appTextPrimary"
            android:textColorHint="?attr/appTextTertiary"
            android:textSize="16sp" />

        <ImageButton
            android:id="@+id/btn_clear_search"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/action_clear_search"
            android:src="@drawable/ic_clear"
            android:visibility="gone"
            app:tint="?attr/appTextTertiary" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_voice_search"
            style="@style/AppIconButtonTonal"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:contentDescription="@string/action_voice_search"
            app:icon="@drawable/ic_mic"
            app:iconSize="20dp" />
    </LinearLayout>

    <!-- ── Match mode ──────────────────────────────────────────────────────── -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:clipToPadding="false"
        android:paddingHorizontal="16dp"
        android:scrollbars="none">

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chip_group_filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:chipSpacingHorizontal="6dp"
            app:selectionRequired="true"
            app:singleLine="true"
            app:singleSelection="true">

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_starts_with"
                style="@style/AppFilterChip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="@string/filter_starts_with" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_contains"
                style="@style/AppFilterChip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/filter_contains" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_exact"
                style="@style/AppFilterChip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/filter_exact" />
        </com.google.android.material.chip.ChipGroup>
    </HorizontalScrollView>

    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/progress_loading"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:indeterminate="true"
        android:visibility="invisible"
        app:indicatorColor="?attr/colorPrimary"
        app:trackColor="@android:color/transparent"
        app:trackCornerRadius="2dp" />

    <!-- Typed in the other language's script: offer to switch direction -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_switch_hint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="12dp"
        android:layout_marginBottom="4dp"
        android:visibility="gone"
        app:cardBackgroundColor="?attr/colorTertiaryContainer"
        app:cardCornerRadius="18dp"
        app:cardElevation="0dp"
        app:strokeWidth="0dp"
        tools:visibility="visible">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingVertical="6dp"
            android:paddingStart="16dp"
            android:paddingEnd="6dp">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_language"
                app:tint="?attr/colorOnTertiaryContainer" />

            <TextView
                android:id="@+id/txt_switch_hint"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:textColor="?attr/colorOnTertiaryContainer"
                android:textSize="13sp"
                tools:text="@string/script_hint_persian" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_switch_hint"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/action_switch"
                android:textColor="?attr/colorOnTertiaryContainer"
                android:textStyle="bold" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- Results -->
        <LinearLayout
            android:id="@+id/layout_results"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/txt_results_count"
                style="@style/AppOverline"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginTop="2dp"
                android:layout_marginBottom="2dp"
                tools:text="48 words found" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recycler_phrase"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingBottom="12dp"
                android:scrollbars="vertical" />
        </LinearLayout>

        <!-- Before typing: recent searches, or a short prompt when there are none -->
        <androidx.core.widget.NestedScrollView
            android:id="@+id/layout_initial"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="12dp"
                android:paddingBottom="16dp">

                <LinearLayout
                    android:id="@+id/layout_prompt"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:paddingHorizontal="24dp"
                    android:paddingTop="40dp">

                    <FrameLayout
                        android:layout_width="88dp"
                        android:layout_height="88dp"
                        android:background="@drawable/bg_icon_circle">

                        <ImageView
                            android:id="@+id/img_prompt"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:layout_gravity="center"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_translate"
                            app:tint="?attr/colorOnPrimaryContainer" />
                    </FrameLayout>

                    <TextView
                        android:id="@+id/txt_prompt_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:gravity="center"
                        android:textColor="?attr/appTextPrimary"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        tools:text="@string/empty_prompt_title_en" />

                    <TextView
                        android:id="@+id/txt_prompt"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:gravity="center"
                        android:lineSpacingMultiplier="1.2"
                        android:text="@string/empty_prompt_text"
                        android:textColor="?attr/appTextSecondary"
                        android:textSize="14sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/layout_recent_searches_header"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="8dp">

                    <TextView
                        style="@style/AppOverline"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/recent_searches" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_clear_history"
                        style="@style/Widget.Material3.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/clear_all" />
                </LinearLayout>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/card_recent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardBackgroundColor="?attr/appCardBackground"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="0dp"
                    app:strokeColor="?attr/appCardBorderColor"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:id="@+id/list_recent"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingVertical="4dp" />
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <!-- No results -->
        <LinearLayout
            android:id="@+id/layout_empty_state"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingHorizontal="32dp"
            android:visibility="gone">

            <FrameLayout
                android:layout_width="88dp"
                android:layout_height="88dp"
                android:background="@drawable/bg_circle"
                android:backgroundTint="?attr/appSurfaceVariant">

                <ImageView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_search"
                    app:tint="?attr/appTextTertiary" />
            </FrameLayout>

            <TextView
                android:id="@+id/txt_empty_message"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center"
                android:textColor="?attr/appTextPrimary"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center"
                android:lineSpacingMultiplier="1.2"
                android:text="@string/no_results_hint"
                android:textColor="?attr/appTextSecondary"
                android:textSize="14sp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_try_contains"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:text="@string/filter_contains" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_empty_switch"
                    style="@style/Widget.Material3.Button.OutlinedButton.Icon"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/action_switch_direction"
                    app:icon="@drawable/ic_swap_horiz" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>

    <!-- Filled by AdUtil; stays hidden when ads are off or none loads -->
    <FrameLayout
        android:id="@+id/ad_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="gone" />

</LinearLayout>
