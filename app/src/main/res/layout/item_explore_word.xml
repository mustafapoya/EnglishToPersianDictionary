<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView style="@style/AppCard" xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/card"
    android:layout_width="168dp"
    android:layout_height="128dp"
    android:layout_marginHorizontal="4dp"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="14dp">

        <View
            android:id="@+id/accent"
            android:layout_width="24dp"
            android:layout_height="4dp"
            android:background="@drawable/bg_pill"
            android:backgroundTint="?attr/colorPrimary" />

        <TextView
            android:id="@+id/text_word"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="?attr/appTextPrimary"
            android:textSize="18sp"
            android:textStyle="bold"
            tools:text="glimmer" />

        <TextView
            android:id="@+id/text_meaning"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:ellipsize="end"
            android:lineSpacingMultiplier="1.15"
            android:maxLines="2"
            android:textColor="?attr/appTextSecondary"
            android:textDirection="rtl"
            android:textSize="14sp"
            tools:text="سوسو زدن، کورسو" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
