<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/scroll_home"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/appBackgroundColor"
    android:clipToPadding="false"
    tools:context=".ui.home.HomeFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="28dp">

        <!-- ── Hero: greeting + search with a direction switch ─────────────── -->
        <LinearLayout
            android:id="@+id/hero_panel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/screen_gutter"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_hero_panel"
            android:clipToOutline="true"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingTop="18dp"
            android:paddingBottom="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/text_date"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:letterSpacing="0.06"
                    android:textAllCaps="true"
                    android:textColor="@color/hero_accent"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    tools:text="Saturday, Oct 3" />

                <LinearLayout
                    android:id="@+id/badge_streak"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:background="@drawable/bg_pill"
                    android:backgroundTint="@color/hero_button"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="10dp">

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_fire"
                        app:tint="@color/bookmark_gold" />

                    <TextView
                        android:id="@+id/text_streak_badge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:textColor="@color/hero_on"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        tools:text="3 days" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/text_greeting"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:textColor="@color/hero_on"
                android:textSize="26sp"
                android:textStyle="bold"
                tools:text="Good afternoon" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/home_prompt"
                android:textColor="@color/hero_on_muted"
                android:textSize="15sp" />

            <!-- Search bar: tapping opens the dictionary; the pill switches direction -->
            <LinearLayout
                android:id="@+id/search_bar"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="18dp"
                android:background="@drawable/bg_pill"
                android:backgroundTint="?attr/appCardBackground"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingEnd="6dp">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_search"
                    app:tint="?attr/colorPrimary" />

                <TextView
                    android:id="@+id/text_search_hint"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="?attr/appTextTertiary"
                    android:textSize="15sp"
                    tools:text="Search English words..." />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_direction"
                    style="@style/Widget.Material3.Button.TonalButton.Icon"
                    android:layout_width="wrap_content"
                    android:layout_height="42dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:minWidth="0dp"
                    android:paddingHorizontal="12dp"
                    android:textSize="13sp"
                    app:backgroundTint="?attr/colorPrimaryContainer"
                    app:icon="@drawable/ic_swap_horiz"
                    app:iconSize="16dp"
                    app:iconTint="?attr/colorOnPrimaryContainer"
                    android:textColor="?attr/colorOnPrimaryContainer"
                    tools:text="EN → FA" />
            </LinearLayout>
        </LinearLayout>

        <!-- ── Daily goal: ring, 7-day activity, call to action ─────────────── -->
        <com.google.android.material.card.MaterialCardView
            style="@style/AppCard.Large"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/screen_gutter"
            android:layout_marginTop="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <FrameLayout
                        android:layout_width="72dp"
                        android:layout_height="72dp">

                        <com.google.android.material.progressindicator.CircularProgressIndicator
                            android:id="@+id/ring_goal"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:max="10"
                            app:indicatorColor="?attr/colorPrimary"
                            app:indicatorSize="72dp"
                            app:trackColor="?attr/colorPrimaryContainer"
                            app:trackCornerRadius="4dp"
                            app:trackThickness="7dp" />

                        <TextView
                            android:id="@+id/text_goal_count"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:textColor="?attr/appTextPrimary"
                            android:textSize="17sp"
                            android:textStyle="bold"
                            tools:text="3/10" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/home_daily_goal"
                            android:textColor="?attr/appTextPrimary"
                            android:textSize="17sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/text_goal_message"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:textColor="?attr/appTextSecondary"
                            android:textSize="13sp"
                            tools:text="7 more cards to reach today's goal" />

                        <TextView
                            android:id="@+id/text_mini_stats"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:textColor="?attr/appTextTertiary"
                            android:textSize="12sp"
                            tools:text="★ 4 saved  ·  🏆 2 learned" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Last 7 days (filled in code) -->
                <LinearLayout
                    android:id="@+id/week_strip"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:orientation="horizontal" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_goal_action"
                    style="@style/AppButton"
                    android:layout_width="match_parent"
                    android:layout_marginTop="16dp"
                    app:icon="@drawable/ic_flashcard_filled"
                    tools:text="Review 4 due cards" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ── Quick tools ──────────────────────────────────────────────────── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/screen_gutter"
            android:layout_marginTop="20dp"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <include
                android:id="@+id/tool_english"
                layout="@layout/view_tool"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1" />

            <include
                android:id="@+id/tool_persian"
                layout="@layout/view_tool"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1" />

            <include
                android:id="@+id/tool_quiz"
                layout="@layout/view_tool"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1" />

            <include
                android:id="@+id/tool_random"
                layout="@layout/view_tool"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1" />
        </LinearLayout>

        <!-- ── Word of the day ──────────────────────────────────────────────── -->
        <com.google.android.material.card.MaterialCardView
            style="@style/AppCard.Large"
            android:id="@+id/card_word_of_day"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/screen_gutter"
            android:layout_marginTop="24dp"
            android:clickable="true"
            android:focusable="true">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_wod_glow">

                <!-- Decorative oversized sparkle -->
                <ImageView
                    android:layout_width="140dp"
                    android:layout_height="140dp"
                    android:layout_gravity="top|end"
                    android:layout_marginTop="-24dp"
                    android:layout_marginEnd="-28dp"
                    android:alpha="0.07"
                    android:importantForAccessibility="no"
                    android:rotation="-12"
                    android:src="@drawable/ic_sparkle"
                    app:tint="?attr/colorPrimary" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingHorizontal="20dp"
                    android:paddingTop="16dp"
                    android:paddingBottom="10dp">

                    <!-- Badge + share -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="28dp"
                            android:background="@drawable/bg_pill"
                            android:backgroundTint="?attr/colorPrimaryContainer"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingHorizontal="10dp">

                            <ImageView
                                android:layout_width="14dp"
                                android:layout_height="14dp"
                                android:importantForAccessibility="no"
                                android:src="@drawable/ic_sparkle"
                                app:tint="?attr/colorOnPrimaryContainer" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="6dp"
                                android:letterSpacing="0.06"
                                android:text="@string/word_of_the_day"
                                android:textAllCaps="true"
                                android:textColor="?attr/colorOnPrimaryContainer"
                                android:textSize="11sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <Space
                            android:layout_width="0dp"
                            android:layout_height="0dp"
                            android:layout_weight="1" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_wod_share"
                            style="@style/AppIconButton"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:layout_marginEnd="-8dp"
                            android:contentDescription="@string/action_share"
                            app:icon="@drawable/ic_share"
                            app:iconSize="20dp"
                            app:iconTint="?attr/appTextTertiary" />
                    </LinearLayout>

                    <!-- The word -->
                    <TextView
                        android:id="@+id/text_wod_word"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:ellipsize="end"
                        android:maxLines="2"
                        android:textColor="?attr/appTextPrimary"
                        android:textDirection="ltr"
                        android:textSize="34sp"
                        android:textStyle="bold"
                        tools:text="serendipity" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/text_wod_summary"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:textColor="?attr/appTextSecondary"
                            android:textSize="13sp"
                            tools:text="English · 3 meanings" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_wod_listen"
                            style="@style/AppIconButtonTonal"
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            android:contentDescription="@string/action_listen"
                            app:icon="@drawable/ic_volume_up"
                            app:iconSize="22dp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_wod_bookmark"
                            style="@style/AppIconButtonTonal"
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            android:layout_marginStart="8dp"
                            android:contentDescription="@string/action_bookmark"
                            app:backgroundTint="?attr/appSurfaceVariant"
                            app:icon="@drawable/ic_star_outline"
                            app:iconSize="22dp" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="16dp"
                        android:layout_marginBottom="6dp"
                        android:background="?attr/appDivider" />

                    <!-- Numbered meanings (filled in code) -->
                    <LinearLayout
                        android:id="@+id/list_wod_meanings"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />

                    <!-- Footer -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/text_wod_more"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:textColor="?attr/appTextTertiary"
                            android:textSize="13sp"
                            tools:text="+4 more meanings" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_wod_open"
                            style="@style/Widget.Material3.Button.TextButton.Icon"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="-12dp"
                            android:text="@string/action_read_more"
                            app:icon="@drawable/ic_arrow_forward"
                            app:iconGravity="end" />
                    </LinearLayout>
                </LinearLayout>
            </FrameLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ── Explore: a carousel of random words ──────────────────────────── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="@dimen/section_label_inset"
            android:paddingEnd="8dp">

            <TextView
                style="@style/AppOverline"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/home_explore" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_shuffle"
                style="@style/Widget.Material3.Button.TextButton.Icon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/home_shuffle"
                app:icon="@drawable/ic_shuffle" />
        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recycler_explore"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipToPadding="false"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
            tools:listitem="@layout/item_explore_word" />

        <!-- ── Recent searches ──────────────────────────────────────────────── -->
        <LinearLayout
            android:id="@+id/section_recent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:orientation="vertical"
            android:visibility="gone"
            tools:visibility="visible">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="@dimen/section_label_inset"
                android:paddingEnd="8dp">

                <TextView
                    style="@style/AppOverline"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/recent_searches" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_clear_recent"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/clear_all" />
            </LinearLayout>

            <com.google.android.material.card.MaterialCardView
                style="@style/AppCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/screen_gutter">

                <LinearLayout
                    android:id="@+id/list_recent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingVertical="4dp" />
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>

        <!-- ── Sponsored (hidden when ads are off) ──────────────────────────── -->
        <include
            android:id="@+id/home_ad"
            layout="@layout/view_home_native_ad" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
