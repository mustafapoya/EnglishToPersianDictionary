<resources xmlns:tools="http://schemas.android.com/tools">
    <!--
        Android 12+ always shows a system splash screen on cold start, which by default
        draws the launcher icon. Replace it with an empty icon on a brand-colored
        background so it blends seamlessly into SplashScreenActivity.
    -->
    <style name="Theme.EnglishToPersian.Splash">
        <item name="android:windowBackground">@color/splash_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:windowSplashScreenBackground">@color/splash_background</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_icon_empty</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@color/splash_background</item>
        <item name="android:windowSplashScreenAnimationDuration">0</item>
    </style>
</resources>
