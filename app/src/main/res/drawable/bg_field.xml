<?xml version="1.0" encoding="utf-8"?>
<!-- Rounded input field; the container uses addStatesFromChildren so it highlights while the text box has focus -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <corners android:radius="26dp" />
            <solid android:color="?attr/appCardBackground" />
            <stroke android:width="2dp" android:color="?attr/colorPrimary" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="26dp" />
            <solid android:color="?attr/appSurfaceVariant" />
            <stroke android:width="1dp" android:color="?attr/appCardBorderColor" />
        </shape>
    </item>
</selector>
